#!/bin/sh /etc/rc.common
#
# Copyright (C) 2026 Arthur97172 <arthur97172@outlook.com>
# SPDX-License-Identifier: GPL-3.0-only
#
# ledcontrol - force the state of every LED exposed through /sys/class/leds.
#
# Two independent switches are stored in UCI:
#
#   ledcontrol.global.status_leds   the device status LEDs (power, Wi-Fi, USB, ...)
#   ledcontrol.global.net_leds      the network port LEDs (wan / lan / port / eth / sw / gphy)
#
# START=99 makes this script run as the very last service during boot, i.e.
# after the kernel LED triggers, the board specific default LED configuration
# and every hardware driver have been initialised. Running any earlier would
# let the vendor defaults overwrite the state we set here.

START=99
STOP=10
USE_PROCD=1

LED_CLASS_DIR="/sys/class/leds"

# A LED belongs to the network ports when its name carries one of the keywords
# wan, lan, port, eth, sw or gphy.
#
# Wi-Fi LEDs are the exception that needs care: they are nearly always named
# "wlan..." or "wlan0"/"wlan2g", and "wlan" contains "lan", so the plain lan
# arm would sweep them into the port group. They are status LEDs, so the wlan
# arm is written first - case takes the first matching pattern, not the best
# one. "ath9k-phy0" and friends (the Wi-Fi PHY LEDs registered by mac80211) are
# status LEDs for the same reason, and are why the port keyword is "gphy"
# rather than the bare "phy": "phy0" must not match.
#
# POSIX case patterns are used rather than the bash [[ ... =~ ... ]] operator:
# /bin/sh on OpenWrt and ImmortalWrt is busybox ash, which implements neither
# [[ ]] nor =~. The bracket expressions below make the match case insensitive,
# so WAN0 / Lan2 / PORT1 are recognised as well as their lower case spellings.
is_net_led() {
	case "$1" in
		# Wi-Fi: a status LED, even though its name contains "lan"
		*[Ww][Ll][Aa][Nn]*) return 1 ;;

		# network port LEDs - one keyword per arm, matched anywhere in the name
		*[Ww][Aa][Nn]*)     return 0 ;;   # wan, WAN0, green:wan
		*[Ll][Aa][Nn]*)     return 0 ;;   # lan, lan1, lan-1, green:lan2
		*[Pp][Oo][Rr][Tt]*) return 0 ;;   # port, usbport, Port2
		*[Ee][Tt][Hh]*)     return 0 ;;   # eth0, eth1, eth0.2
		*[Ss][Ww]*)         return 0 ;;   # sw1, switch:green
		*[Gg][Pp][Hh][Yy]*) return 0 ;;   # gphy0, gphy1

		*) return 1 ;;
	esac
}

# led_apply <status_value> <net_value>
#
# Each LED is written the value of the switch that owns it, which covers the
# four combinations exactly:
#
#   status_leds net_leds | status LEDs | port LEDs | result
#   ---------------------+-------------+-----------+-----------------------
#        0           0    |      0      |     0     | everything off
#        0           1    |      0      |     1     | only ports stay on
#        1           0    |      1      |     0     | only ports go dark
#        1           1    |      1      |     1     | everything on
#
# "On" is written as the LED's own max_brightness rather than a hard coded 1.
# brightness is not a boolean: the LED class clamps writes to
# [0, max_brightness] (led_set_brightness_nosleep), and a multicolor LED
# scales every colour channel by brightness / max_brightness
# (led_mc_calc_color_components). A plain GPIO LED has max_brightness 1, so it
# is unaffected, but a PWM or RGB LED has 255 - writing 1 there is 1/255 of the
# range, i.e. visually off. max_brightness is registered by the LED class for
# every LED and the kernel forces it to LED_FULL when a driver leaves it 0
# (led-class.c), so reading it is always safe.
#
# "Off" stays a literal 0: writing 0 is what makes the kernel detach the LED
# trigger (led_trigger_remove), so a dark LED stays dark.
led_apply() {
	local status_value="$1"
	local net_value="$2"
	local led value max

	for led in "$LED_CLASS_DIR"/*; do
		[ -e "$led/brightness" ] || continue

		if is_net_led "${led##*/}"; then
			value="$net_value"
		else
			value="$status_value"
		fi

		if [ "$value" = "0" ]; then
			echo 0 > "$led/brightness" 2>/dev/null
			continue
		fi

		max="$(cat "$led/max_brightness" 2>/dev/null)"

		# Unreadable, non numeric or 0 - none of which the LED class should
		# ever produce - fall back to 1 rather than writing 0, which would
		# turn the LED off when it was asked to turn on.
		case "$max" in
			''|*[!0-9]*|0) max=1 ;;
		esac

		echo "$max" > "$led/brightness" 2>/dev/null
	done
}

# Anything other than a literal 0 counts as "on" - the same rule the 1.0.x
# script used for its single "enable" switch.
led_normalise() {
	case "$1" in
		0) echo 0 ;;
		*) echo 1 ;;
	esac
}

start_service() {
	local legacy status_leds net_leds

	config_load ledcontrol

	# 1.0.x stored a single "enable" switch. Use its value for both new
	# switches when they are absent, so a system that was upgraded - or whose
	# /etc/config/ledcontrol was restored from a 1.0.x backup - keeps the
	# state the user last chose instead of silently turning everything on.
	config_get legacy global enable ''

	config_get status_leds global status_leds "${legacy:-1}"
	config_get net_leds global net_leds "${legacy:-1}"

	status_leds="$(led_normalise "$status_leds")"
	net_leds="$(led_normalise "$net_leds")"

	logger -t ledcontrol "applying LED state: status=$status_leds net=$net_leds"
	led_apply "$status_leds" "$net_leds"
}

stop_service() {
	led_apply 1 1
}

reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger "ledcontrol"
}
