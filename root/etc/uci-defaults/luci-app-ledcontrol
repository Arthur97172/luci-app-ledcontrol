#
# uci-defaults script - executed exactly once, on the first boot after the
# package has been installed. It makes sure the UCI configuration exists and
# that the init script is executable. Exiting with 0 makes the OpenWrt build
# system delete this script again, so it never runs twice.
#
# Simplified Chinese is deliberately absent here. It ships in the separate
# luci-i18n-ledcontrol-zh-cn package, whose own uci-defaults - generated by
# luci.mk - registers 简体中文 in luci.languages. Registering it from this
# package instead would offer a language whose catalog is not installed, and
# selecting it would silently show English.

[ -f /etc/config/ledcontrol ] || touch /etc/config/ledcontrol

# 1.0.x had a single ledcontrol.global.enable switch. Fold it into the two
# switches that replaced it, so that upgrading keeps the state the user last
# chose, then drop the obsolete option. `uci -q get` prints nothing when the
# option is absent, which leaves a fresh install untouched.
legacy="$(uci -q get ledcontrol.global.enable)"

if [ -n "$legacy" ]; then
	uci -q set ledcontrol.global.status_leds="$legacy"
	uci -q set ledcontrol.global.net_leds="$legacy"
	uci -q delete ledcontrol.global.enable
fi

# Both switches default to on, which is what the kernel and the board specific
# LED configuration set up during boot anyway.
[ -n "$(uci -q get ledcontrol.global.status_leds)" ] || uci -q set ledcontrol.global.status_leds='1'
[ -n "$(uci -q get ledcontrol.global.net_leds)" ] || uci -q set ledcontrol.global.net_leds='1'

uci -q commit ledcontrol

chmod 0755 /etc/init.d/ledcontrol 2>/dev/null

exit 0
