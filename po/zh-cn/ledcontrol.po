#: htdocs/luci-static/resources/view/ledcontrol.js:29
#: root/usr/share/luci/menu.d/luci-app-ledcontrol.json
msgid "LED Control"
msgstr "LED 指示灯控制"

#: htdocs/luci-static/resources/view/ledcontrol.js:30
msgid "Turn the device status LEDs and the network port LEDs on or off independently."
msgstr "可分别打开或关闭设备指示灯与网口指示灯。"

#: htdocs/luci-static/resources/view/ledcontrol.js:32
msgid "Global Settings"
msgstr "全局设置"

#: htdocs/luci-static/resources/view/ledcontrol.js:36
msgid "Enable Status LEDs"
msgstr "启用设备指示灯"

#: htdocs/luci-static/resources/view/ledcontrol.js:37
msgid "Controls the device status LEDs, such as the power, Wi-Fi or USB indicators."
msgstr "控制设备指示灯，例如电源、Wi-Fi、USB 等指示灯。"

#: htdocs/luci-static/resources/view/ledcontrol.js:41
msgid "Enable Network Port LEDs"
msgstr "启用网口指示灯"

#: htdocs/luci-static/resources/view/ledcontrol.js:42
msgid "Controls the network port LEDs, identified by \"wan\", \"lan\", \"port\", \"eth\", \"sw\" or \"gphy\" in their name. Wi-Fi LEDs are status LEDs."
msgstr "控制网口指示灯，即名称中包含 \"wan\"、\"lan\"、\"port\"、\"eth\"、\"sw\" 或 \"gphy\" 的 LED；Wi-Fi 指示灯属于设备指示灯。"

#: htdocs/luci-static/resources/view/ledcontrol.js:84
msgid "Failed to apply the LED settings: %s"
msgstr "应用 LED 设置失败：%s"
