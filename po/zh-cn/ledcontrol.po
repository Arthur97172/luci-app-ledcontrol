#: htdocs/luci-static/resources/view/ledcontrol.js:29
#: root/usr/share/luci/menu.d/luci-app-ledcontrol.json
msgid "LED Control"
msgstr "LED 指示灯控制"

#: htdocs/luci-static/resources/view/ledcontrol.js:30
msgid "Turn all system LEDs on or off with a single switch."
msgstr "通过一个开关即可打开或关闭系统上所有的 LED 指示灯。"

#: htdocs/luci-static/resources/view/ledcontrol.js:32
msgid "Global Settings"
msgstr "全局设置"

#: htdocs/luci-static/resources/view/ledcontrol.js:36
msgid "Enable LEDs"
msgstr "启用 LED 指示灯"

#: htdocs/luci-static/resources/view/ledcontrol.js:37
msgid "Controls the status of LEDs. Settings take effect immediately and will persist after a reboot (ON or OFF)."
msgstr "控制 LED 的状态。设置立即生效，且在路由器重启后依然会自动保持您选择的状态（开启或关闭）。"

#: htdocs/luci-static/resources/view/ledcontrol.js:79
msgid "Failed to apply the LED settings: %s"
msgstr "应用 LED 设置失败：%s"
